    { "name": "registered-entity-revision-collection", "kind": "registered-document-id", "value": "choirloom:score/entity-revision-collection/0.1.0" },
    { "name": "registered-schema-catalog",            "kind": "registered-document-id", "value": "choirloom:score/schema-catalog/0.1.0" },

    { "name": "entry-rt-010", "kind": "entry", "value": { "schemaId": "choirloom:score/rational-time", "schemaVersion": "0.1.0", "documentId": "choirloom:score/rational-time/0.1.0", "path": "schemas/score/synthetic-rt-0.1.0.schema.json", "status": "Draft" } },
    { "name": "entry-rt-020", "kind": "entry", "value": { "schemaId": "choirloom:score/rational-time", "schemaVersion": "0.2.0", "documentId": "choirloom:score/rational-time/0.2.0", "path": "schemas/score/synthetic-rt-0.2.0.schema.json", "status": "Draft" } },
    { "name": "entry-rt-100", "kind": "entry", "value": { "schemaId": "choirloom:score/rational-time", "schemaVersion": "1.0.0", "documentId": "choirloom:score/rational-time/1.0.0", "path": "schemas/score/synthetic-rt-1.0.0.schema.json", "status": "Draft" } },
    { "name": "entry-rt-110", "kind": "entry", "value": { "schemaId": "choirloom:score/rational-time", "schemaVersion": "1.1.0", "documentId": "choirloom:score/rational-time/1.1.0", "path": "schemas/score/synthetic-rt-1.1.0.schema.json", "status": "Draft" } },

    { "name": "edge-readable-010-020",  "kind": "edge", "value": { "from": "choirloom:score/rational-time/0.1.0", "to": "choirloom:score/rational-time/0.2.0", "kind": "readable" } },
    { "name": "edge-migration-020-100", "kind": "edge", "value": { "from": "choirloom:score/rational-time/0.2.0", "to": "choirloom:score/rational-time/1.0.0", "kind": "migration" } },
    { "name": "edge-migration-100-110", "kind": "edge", "value": { "from": "choirloom:score/rational-time/1.0.0", "to": "choirloom:score/rational-time/1.1.0", "kind": "migration" } },

    { "name": "compat-exact",           "kind": "compat", "value": { "schemaId": "choirloom:score/rational-time", "from": "0.1.0", "to": "0.1.0", "expected": "Exact" } },
    { "name": "compat-readable",        "kind": "compat", "value": { "schemaId": "choirloom:score/rational-time", "from": "0.1.0", "to": "0.2.0", "expected": "Readable" } },
    { "name": "compat-requires-migration", "kind": "compat", "value": { "schemaId": "choirloom:score/rational-time", "from": "0.2.0", "to": "1.0.0", "expected": "RequiresMigration" } },
    { "name": "compat-unsupported-no-edge", "kind": "compat", "value": { "schemaId": "choirloom:score/rational-time", "from": "0.1.0", "to": "1.1.0", "expected": "Unsupported" } },
    { "name": "compat-unsupported-unknown-version", "kind": "compat", "value": { "schemaId": "choirloom:score/rational-time", "from": "0.1.0", "to": "0.3.0", "expected": "Unsupported" } },

    { "name": "lookup-exact",             "kind": "lookup", "value": { "schemaId": "choirloom:score/rational-time", "version": "0.1.0", "expectedDiagnostic": "" } },
    { "name": "lookup-unknown-schema",    "kind": "lookup", "value": { "schemaId": "choirloom:score/unknown-thing", "version": "0.1.0", "expectedDiagnostic": "unknown-schema" } },
    { "name": "lookup-unknown-version",   "kind": "lookup", "value": { "schemaId": "choirloom:score/rational-time", "version": "0.3.0", "expectedDiagnostic": "unknown-schema-version" } },
    { "name": "lookup-future-version",    "kind": "lookup", "value": { "schemaId": "choirloom:score/rational-time", "version": "99.0.0", "expectedDiagnostic": "unsupported-future-version" } },

    { "name": "plan-same",            "kind": "plan", "value": { "from": "choirloom:score/rational-time/0.1.0", "to": "choirloom:score/rational-time/0.1.0", "expectedSteps": 0, "expectedDiagnostic": "" } },
    { "name": "plan-migration-chain", "kind": "plan", "value": { "from": "choirloom:score/rational-time/0.2.0", "to": "choirloom:score/rational-time/1.1.0", "expectedSteps": 2, "expectedDiagnostic": "" } },
    { "name": "plan-readable-only",   "kind": "plan", "value": { "from": "choirloom:score/rational-time/0.1.0", "to": "choirloom:score/rational-time/0.2.0", "expectedSteps": 0, "expectedDiagnostic": "missing-migration-edge" } },
    { "name": "plan-no-edge",         "kind": "plan", "value": { "from": "choirloom:score/rational-time/0.1.0", "to": "choirloom:score/rational-time/1.0.0", "expectedSteps": 0, "expectedDiagnostic": "missing-migration-edge" } },
    { "name": "plan-future-target",   "kind": "plan", "value": { "from": "choirloom:score/rational-time/0.1.0", "to": "choirloom:score/rational-time/5.0.0", "expectedSteps": 0, "expectedDiagnostic": "unsupported-future-version" } },

    { "name": "inspect-ok",               "kind": "inspect", "value": { "schemaId": "choirloom:score/rational-time", "version": "0.1.0", "expectedDiagnostic": "" } },
    { "name": "inspect-missing-version",  "kind": "inspect", "value": { "schemaId": "choirloom:score/rational-time", "expectedDiagnostic": "missing-schema-version" } },
    { "name": "inspect-malformed-version", "kind": "inspect", "value": { "schemaId": "choirloom:score/rational-time", "version": "1.2", "expectedDiagnostic": "malformed-schema-version" } },
    { "name": "inspect-overflow-version", "kind": "inspect", "value": { "schemaId": "choirloom:score/rational-time", "version": "4294967296.0.0", "expectedDiagnostic": "schema-version-out-of-range" } },
    { "name": "inspect-unknown-schema",   "kind": "inspect", "value": { "schemaId": "choirloom:score/unknown-thing", "version": "0.1.0", "expectedDiagnostic": "unknown-schema" } },
    { "name": "inspect-future-version",   "kind": "inspect", "value": { "schemaId": "choirloom:score/rational-time", "version": "99.0.0", "expectedDiagnostic": "unsupported-future-version" } },
    { "name": "inspect-unknown-version",  "kind": "inspect", "value": { "schemaId": "choirloom:score/rational-time", "version": "0.3.0", "expectedDiagnostic": "unknown-schema-version" } }
  ]
