{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "choirloom:score/entity-revision-collection/0.1.0",
  "title": "EntityRevisionGoldenCollection",
  "version": "0.1.0",
  "description": "Versioned envelope for tests/golden/entity_revision.samples.json. Each case has a 'name', a 'kind' selecting the wire form of 'value' (entity-id, revision-id, or project-revision-metadata), and an optional 'note'. The value schemas are referenced by their $ids below. DRAFT / NON-FROZEN; explicit versioned migration is required before evolution, and an ADR is only needed if a frozen decision changes (see docs/entity-revision-notes.md).",
  "type": "object",
  "required": ["cases"],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "kind", "value"],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string"
          },
          "note": {
            "type": "string"
          },
          "kind": {
            "type": "string",
            "enum": ["entity-id", "revision-id", "project-revision-metadata"]
          },
          "value": {}
        },
        "allOf": [
          {
            "if": {
              "properties": { "kind": { "const": "entity-id" } },
              "required": ["kind"]
            },
            "then": {
              "properties": { "value": { "$ref": "choirloom:score/entity-id/0.1.0" } }
            }
          },
          {
            "if": {
              "properties": { "kind": { "const": "revision-id" } },
              "required": ["kind"]
            },
            "then": {
              "properties": { "value": { "$ref": "choirloom:score/revision-id/0.1.0" } }
            }
          },
          {
            "if": {
              "properties": { "kind": { "const": "project-revision-metadata" } },
              "required": ["kind"]
            },
            "then": {
              "properties": { "value": { "$ref": "choirloom:score/project-revision-metadata/0.1.0" } }
            }
          }
        ]
      }
    }
  }
}
